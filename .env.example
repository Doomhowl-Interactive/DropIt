# Copy to .env — the server loads it on boot.

# Signing key for the session JWT. Required; generate with:
#   openssl rand -base64 32
JWT_SECRET=

PORT=8080

# Path to the SQLite database file.
DATABASE_URL=./data/database.db

# Where uploaded files are written.
STORAGE_DIR=./uploads
# Where the logo and favicon are served from.
STATIC_DIR=./static

# Cookie domain; leave empty for a host-only cookie.
DOMAIN=
# Marks the auth and CSRF cookies Secure.
USE_HTTPS=false

# Password for the bootstrap "admin" account. Leave empty to have a random one
# generated and printed once on first boot.
ADMIN_PASSWORD=

# Comma-separated Host header allow-list ("*" accepts anything).
ALLOWED_HOSTS=*
# Honour X-Forwarded-* headers (enable behind a reverse proxy).
TRUST_PROXY_HEADERS=false
