# Copy to .env — the server loads it on boot.

PORT=3400
JWT_SECRET=
DATABASE_URL=
STATIC_DIR=./static
DOMAIN=
USE_HTTPS=false
ADMIN_PASSWORD=
MCP_MAX_BODY=35mb
MCP_MAX_UPLOAD_BYTES=26214400
MCP_ALLOWED_ORIGINS=

# Where uploads are kept: local | s3. Defaults to s3 once S3_BUCKET is set.
STORAGE_DRIVER=local
STORAGE_DIR=./uploads

# S3-compatible object storage, used when STORAGE_DRIVER=s3.
# Leave S3_ENDPOINT empty for AWS; set it for MinIO, Cloudflare R2,
# Backblaze B2, Garage, ... Credentials may be left empty to fall back to the
# AWS SDK's own chain (instance role, ~/.aws/credentials, AWS_*).
S3_BUCKET=
S3_PREFIX=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing; defaults to true whenever S3_ENDPOINT is set.
S3_FORCE_PATH_STYLE=
