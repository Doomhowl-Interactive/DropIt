# Copy to .env — the server loads it on boot.

# Signing key for the session JWT. Required; generate with:
#   openssl rand -base64 32
JWT_SECRET=

PORT=8080

# MySQL (or TiDB, which speaks the MySQL protocol) connection string.
DATABASE_URL=mysql://dropit:dropit@localhost:3306/dropit
# TiDB Cloud requires TLS. For simple TLS, append this URL query instead:
#   ?ssl=%7B%22rejectUnauthorized%22%3Atrue%7D
# For CA-verified TLS, set this to the path of the provider's PEM certificate.
DATABASE_SSL_CA=

# Where uploaded files are written.
STORAGE_DIR=./uploads
# Where the logo and favicon are served from.
STATIC_DIR=./static

# Cookie domain; leave empty for a host-only cookie.
DOMAIN=
# Marks the auth and CSRF cookies Secure.
USE_HTTPS=false

# Password for the bootstrap "admin" account. Leave empty to have a random one
# generated and printed once on first boot.
ADMIN_PASSWORD=

# Comma-separated Host header allow-list ("*" accepts anything).
ALLOWED_HOSTS=*
# Honour X-Forwarded-* headers (enable behind a reverse proxy).
TRUST_PROXY_HEADERS=false

# --- MCP server (/mcp) ---------------------------------------------------
# Mint access tokens for it at /admin/mcp.

# Set to false to stop serving the endpoint entirely.
MCP_ENABLED=true
# Request body limit. Uploads arrive base64-encoded, so keep this ~4/3 of
# MCP_MAX_UPLOAD_BYTES.
MCP_MAX_BODY=35mb
# Largest file upload_file accepts / get_file returns, in bytes.
MCP_MAX_UPLOAD_BYTES=26214400
# Comma-separated Origin allow-list; empty disables the Origin check.
MCP_ALLOWED_ORIGINS=
