{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "dropit": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "static",
                "output": "/static",
                "ignore": ["**/*.xcf"]
              }
            ],
            "styles": ["src/styles.css"],
            "externalDependencies": [
              "multer",
              "bcryptjs",
              "jsonwebtoken",
              "cookie-parser",
              "express",
              "@modelcontextprotocol/sdk",
              "@modelcontextprotocol/sdk/*",
              "swagger-ui-express"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.55MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dropit:build:production"
            },
            "development": {
              "buildTarget": "dropit:build:development",
              "hmr": true,
              "liveReload": true,
              "poll": 1000
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
